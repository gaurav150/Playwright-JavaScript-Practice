{
  "name": "playwright_with_javascript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "regression": "npx playwright test --workers=2",
    "allureReport": "npx playwright test --reporter=line,allure-playwright",
    "uiMode": "npx playwright test --ui",
    "headedMode": "npx playwright test --headed",
    "jenkinsStart": "brew services start jenkins-lts",
    "jenkinsStop": "brew services stop jenkins-lts",
    "cucumberRegression": "npx cucumber-js --tags '@Regression' --format html:cucumber-report.html",
    "cucumberValidations": "npx cucumber-js --tags '@validation' --format html:cucumber-report.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "allure-playwright": "^3.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "exceljs": "^4.4.0"
  }
}
